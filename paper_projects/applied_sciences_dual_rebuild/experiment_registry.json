    "main_table_minimum": "E4",
    "supplement_minimum": "E3",
    "prohibited": [
      "fabricated or manually transcribed numerical results",
      "post-hoc subset selection to obtain significance",
      "calling AI-assisted labels human-gold",
      "using development-touched instances as a sealed test",
      "promoting an experiment with unresolved leakage, license, safety, or provenance defects"
    ]
