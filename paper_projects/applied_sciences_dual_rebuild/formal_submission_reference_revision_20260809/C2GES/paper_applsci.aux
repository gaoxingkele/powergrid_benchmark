\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview and mechanism detail of the deterministic C\textsuperscript  {2}GES{} pipeline. \textbf  {(a)} Complete reports pass candidate and leakage gates; retained sentences receive lexical roles and form a typed textual proxy graph. The normalized $Q$, $R$, $G$, $C$, and $P$ channels feed the same redundancy-aware selector. The registered no-CF ablation sets $C$ to zero without renormalizing the other coefficients. \textbf  {(b)} For candidate node $i$, path-deletion loss is obtained by removing $i$, recomputing qualified-path utility, and taking $C_i=U(G)-U(G\setminus i)$. The graph is a structural text proxy and does not identify physical causal effects.}}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:algorithm}{{1}{6}{Overview and mechanism detail of the deterministic \cges {} pipeline. \textbf {(a)} Complete reports pass candidate and leakage gates; retained sentences receive lexical roles and form a typed textual proxy graph. The normalized $Q$, $R$, $G$, $C$, and $P$ channels feed the same redundancy-aware selector. The registered no-CF ablation sets $C$ to zero without renormalizing the other coefficients. \textbf {(b)} For candidate node $i$, path-deletion loss is obtained by removing $i$, recomputing qualified-path utility, and taking $C_i=U(G)-U(G\setminus i)$. The graph is a structural text proxy and does not identify physical causal effects}{figure.caption.2}{}}
\newlabel{fig:algorithm@cref}{{[figure][1][]1}{[1][6][]6}{}{}{}}
