{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:journal-article-atlas:observation:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "field_id",
    "value",
    "status",
    "evidence",
    "method",
    "annotator",
    "version"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "field_id": {
      "enum": [
        "paper.title",
        "paper.doi",
        "paper.journal",
        "paper.publisher",
        "paper.year",
        "paper.article_type",
        "paper.special_issue",
        "paper.topic",
        "paper.relevance",
        "paper.version",
        "paper.retraction_status",
        "paper.source_sha256",
        "paper.pages",
        "paper.body_words",
        "paper.abstract_words",
        "paper.section_count_l1",
        "paper.section_count_all",
        "paper.paragraph_count",
        "paper.paragraph_words_mean",
        "paper.paragraph_words_median",
        "paper.paragraph_words_p10",
        "paper.paragraph_words_p90",
        "paper.equation_count_numbered",
        "paper.equation_count_unnumbered",
        "paper.equation_count_inline",
        "paper.equation_count_appendix",
        "paper.theorem_count",
        "paper.proof_count",
        "paper.algorithm_count",
        "paper.experiment_count",
        "paper.ablation_count",
        "paper.ablation_variant_count",
        "paper.factorial_count",
        "paper.sensitivity_count",
        "paper.dataset_count",
        "paper.baseline_count",
        "paper.figure_count",
        "paper.figure_panel_count",
        "paper.table_count",
        "paper.reference_count",
        "paper.framework_summary",
        "paper.contribution_summary",
        "paper.conclusion_summary",
        "paper.logic_closure_rate",
        "paper.code_availability",
        "paper.data_availability",
        "paper.ethics_disclosure",
        "paper.ai_disclosure",
        "section.heading",
        "section.level",
        "section.parent_id",
        "section.order",
        "section.words",
        "section.paragraphs",
        "section.body_share",
        "section.role",
        "section.input_commitment",
        "section.core_logic",
        "section.output_commitment",
        "section.rq_ids",
        "section.internal_sequence",
        "section.transition_quality",
        "paragraph.section_id",
        "paragraph.span_ids",
        "paragraph.words",
        "paragraph.sentences",
        "paragraph.role_primary",
        "paragraph.role_secondary",
        "paragraph.topic_sentence_position",
        "paragraph.claim_ids",
        "paragraph.evidence_ids",
        "paragraph.transition_to_next",
        "paragraph.hedging",
        "paragraph.causal_strength",
        "paragraph.tense",
        "paragraph.voice",
        "paragraph.functional_paraphrase",
        "equation.label",
        "equation.parent_group",
        "equation.type_primary",
        "equation.type_secondary",
        "equation.function",
        "equation.origin",
        "equation.assumptions",
        "equation.symbols_defined",
        "equation.dimension_consistent",
        "equation.derives_from",
        "equation.implemented_by",
        "equation.tested_by",
        "algorithm.family_l1",
        "algorithm.family_l2",
        "algorithm.family_l3",
        "algorithm.composition",
        "algorithm.inputs",
        "algorithm.outputs",
        "algorithm.modules",
        "algorithm.novel_modules",
        "algorithm.training_inference_split",
        "algorithm.constraints",
        "algorithm.complexity",
        "algorithm.convergence",
        "algorithm.hyperparameters",
        "algorithm.implementation_match",
        "experiment.rq",
        "experiment.design_type",
        "experiment.dataset_ids",
        "experiment.comparators",
        "experiment.factors",
        "experiment.controlled_variables",
        "experiment.confounders",
        "experiment.matching_basis",
        "experiment.tuning_budget",
        "experiment.seeds",
        "experiment.scenario_count",
        "experiment.run_count",
        "experiment.metrics",
        "experiment.primary_endpoint",
        "experiment.test_access_status",
        "experiment.external_validation",
        "experiment.negative_results",
        "experiment.failures",
        "experiment.runtime",
        "experiment.peak_memory",
        "statistics.analysis_unit",
        "statistics.independent_n",
        "statistics.estimand",
        "statistics.data_distribution",
        "statistics.dependence",
        "statistics.missingness",
        "statistics.imbalance",
        "statistics.assumptions",
        "statistics.theory_family",
        "statistics.method",
        "statistics.effect_size",
        "statistics.confidence_interval",
        "statistics.multiplicity",
        "statistics.power_precision",
        "statistics.robustness",
        "statistics.leakage_control",
        "statistics.appropriateness",
        "dataset.name",
        "dataset.kind",
        "dataset.unit",
        "dataset.n",
        "dataset.time_span",
        "dataset.split",
        "dataset.provenance",
        "dataset.preprocessing",
        "dataset.externality",
        "dataset.synthetic_disclosure",
        "table.label",
        "table.type",
        "table.rows_subject",
        "table.columns",
        "table.units",
        "table.sample_size_visible",
        "table.uncertainty_visible",
        "table.statistical_marks",
        "table.claim_ids",
        "table.redundant_with",
        "figure.label",
        "figure.type",
        "figure.panel_count",
        "figure.axes_units",
        "figure.uncertainty_display",
        "figure.framework_modules",
        "figure.framework_edges",
        "figure.claim_ids",
        "figure.source_data",
        "figure.visual_integrity",
        "conclusion.rq_answers",
        "conclusion.main_findings",
        "conclusion.quantified_effects",
        "conclusion.mechanism",
        "conclusion.limits",
        "conclusion.negative_findings",
        "conclusion.practical_meaning",
        "conclusion.future_work",
        "conclusion.unsupported_new_claims",
        "theory.discipline",
        "theory.named_theory",
        "theory.usage_depth",
        "theory.assumptions",
        "theory.interfaces",
        "theory.validation",
        "language.term",
        "language.category",
        "language.function",
        "language.section_role",
        "language.document_frequency",
        "language.normalized_frequency",
        "language.abstract_frame",
        "language.register",
        "language.causal_strength",
        "language.reuse_boundary",
        "difficulty.theory",
        "difficulty.algorithm",
        "difficulty.statistics",
        "difficulty.data",
        "difficulty.engineering",
        "difficulty.cross_discipline",
        "difficulty.composite",
        "difficulty.rationale",
        "difficulty.rating_version",
        "quality.soundness",
        "quality.evidence_strength",
        "quality.fairness",
        "quality.statistical_validity",
        "quality.reproducibility",
        "quality.narrative_clarity",
        "quality.claim_boundary"
      ]
    },
    "value": {},
    "status": {
      "enum": [
        "verified",
        "automatic_candidate",
        "not_reported",
        "not_applicable",
        "extraction_failed",
        "uncertain",
        "not_assessed"
      ]
    },
    "method": {
      "type": "string"
    },
    "annotator": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_sha256",
          "locator"
        ],
        "properties": {
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "locator": {
            "type": "object"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_reported",
              "not_applicable",
              "extraction_failed",
              "uncertain",
              "not_assessed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "automatic_candidate"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "not": {
              "type": "null"
            }
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}