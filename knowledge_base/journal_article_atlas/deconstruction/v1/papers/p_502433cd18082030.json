  "sections": [
    {
      "number": "1",
      "title": "Introduction",
      "pages": [
        1,
        2,
        3,
        4,
        5
      ],
      "core_logic": "医院节能/净零动机→方法与混合模型文献→九模型与温度特征比较，Tables1/2为概括而非实验。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_502433cd18082030.sections.1",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "2",
      "title": "Data",
      "pages": [
        5,
        6
      ],
      "core_logic": "医院多病区实测电耗与非同期TMY温度两源。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_502433cd18082030.sections.2",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "2.1",
      "title": "NHS Electricity Demand Dataset",
      "pages": [
        5
      ],
      "core_logic": "EnergyLogix记录5区域1kWh脉冲、半小时累积每小时上传，15个月；合并为单院单序列。",
      "level": 2,
      "parent_number": "2",
      "object_id": "p_502433cd18082030.sections.3",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "2.2",
      "title": "Weather Dataset",
      "pages": [
        5,
        6
      ],
      "core_logic": "2007–16挑月形成TMY，非2017–19同期观测；报告均值10.36℃SD5.57。",
      "level": 2,
      "parent_number": "2",
      "object_id": "p_502433cd18082030.sections.4",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "3",
      "title": "Forecasting Models and Evaluation Metrics",
      "pages": [
        6,
        7,
        8,
        9
      ],
      "core_logic": "12个月训练3个月测试→单模型和残差串联→适用边界→误差指标。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_502433cd18082030.sections.5",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "3.1",
      "title": "Forecasting Models",
      "pages": [
        6,
        7,
        8
      ],
      "core_logic": "LASSO/SVR/FBP/LSTM基本配置，五双阶段组合。",
      "level": 2,
      "parent_number": "3",
      "object_id": "p_502433cd18082030.sections.6",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "3.1.1",
      "title": "Multistage Forecasting",
      "pages": [
        7,
        8
      ],
      "core_logic": "训练残差由一级拟合产生，二级预测加到一级测试预测；同算法/异算法区分。",
      "level": 3,
      "parent_number": "3.1",
      "object_id": "p_502433cd18082030.sections.7",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "3.1.2",
      "title": "Limitations of Residual Forecasting",
      "pages": [
        8
      ],
      "core_logic": "单独列长期、基础模型依赖、残差平稳与其他不确定性限制，但未统计检验。",
      "level": 3,
      "parent_number": "3.1",
      "object_id": "p_502433cd18082030.sections.8",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "3.2",
      "title": "Metrics to Evaluate the Forecasting Models",
      "pages": [
        8,
        9
      ],
      "core_logic": "R²、MAE、RMSE，讨论离群敏感；建议性删离群不等于实际已删。",
      "level": 2,
      "parent_number": "3",
      "object_id": "p_502433cd18082030.sections.9",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "4",
      "title": "Forecasting Results and Discussion",
      "pages": [
        9,
        10,
        11,
        12,
        13,
        14,
        15
      ],
      "core_logic": "单模型→同类双阶段→异类双阶段→全表/残差解释。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_502433cd18082030.sections.10",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "4.1",
      "title": "Single Models",
      "pages": [
        9,
        10,
        11
      ],
      "core_logic": "LSTM最优；温度多数变化小但FBP显著变差，不能因而断言气温无因果影响。",
      "level": 2,
      "parent_number": "4",
      "object_id": "p_502433cd18082030.sections.11",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "4.2",
      "title": "Multistage Models with Similar Algorithms",
      "pages": [
        11,
        12
      ],
      "core_logic": "SVR-SVR/FBP-FBP，FBP温度版R²68.81；无温版68.06。",
      "level": 2,
      "parent_number": "4",
      "object_id": "p_502433cd18082030.sections.12",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "4.3",
      "title": "Multistage Models with Hybrid Algorithms",
      "pages": [
        12,
        13
      ],
      "core_logic": "三异构串联×温度，最佳FBP-LSTM无温R²68.22仍低于单FBP/LSTM。",
      "level": 2,
      "parent_number": "4",
      "object_id": "p_502433cd18082030.sections.13",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "4.4",
      "title": "Evaluation and Discussions",
      "pages": [
        13,
        14,
        15
      ],
      "core_logic": "Table7汇总与残差直方图，用近正态解释二级可预测有推断缺口。",
      "level": 2,
      "parent_number": "4",
      "object_id": "p_502433cd18082030.sections.14",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "5",
      "title": "Conclusions and Future Work",
      "pages": [
        15
      ],
      "core_logic": "LSTM领先/温度弱收益和混合改善总体说法，后者不被同基底表格充分支持；更长时段/DR/节能/跨院未来。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_502433cd18082030.sections.15",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
    {
      "number": "back",
      "title": "Declarations",
      "pages": [
        16
      ],
      "core_logic": "EPSRC部分资助，EnergyLogix设备支持，数据需三方许可，声明无冲突。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_502433cd18082030.sections.16",
      "source_sha256": "502433cd180820300e79ff0872c8662dcf5f143319d5a6132f72b4bd4f7a72e7"
    },
