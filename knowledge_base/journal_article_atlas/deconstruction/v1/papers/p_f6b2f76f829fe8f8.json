  "sections": [
    {
      "number": "1",
      "title": "Introduction",
      "pages": [
        1,
        2,
        3
      ],
      "core_logic": "离散LSTM的两项挑战→连续NODE→三组with/without NODE对照承诺。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_f6b2f76f829fe8f8.sections.1",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "2",
      "title": "Related Work",
      "pages": [
        3,
        4,
        5
      ],
      "core_logic": "统计/ML/DL三类文献与作者既有工作→宣称NODE优势；概念比较不是实际基线实验。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_f6b2f76f829fe8f8.sections.2",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "2.1",
      "title": "Statistical Method",
      "pages": [
        3
      ],
      "core_logic": "ARIMA/SARIMA与数据平稳性论述；其只能小数据的泛化断言无本实验检验。",
      "level": 2,
      "parent_number": "2",
      "object_id": "p_f6b2f76f829fe8f8.sections.3",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "2.2",
      "title": "Machine Learning Method",
      "pages": [
        3
      ],
      "core_logic": "LightGBM/SVM回顾，NODE内存优势宣称未实测。",
      "level": 2,
      "parent_number": "2",
      "object_id": "p_f6b2f76f829fe8f8.sections.4",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "2.3",
      "title": "Deep Learning Method",
      "pages": [
        3,
        4,
        5
      ],
      "core_logic": "LSTM变体和作者既有方法→动态连续表征的差异化叙事。",
      "level": 2,
      "parent_number": "2",
      "object_id": "p_f6b2f76f829fe8f8.sections.5",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "3",
      "title": "Background Knowledge",
      "pages": [
        5,
        6,
        7,
        8
      ],
      "core_logic": "门控、双向合成、连续残差/ODE基础。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_f6b2f76f829fe8f8.sections.6",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "3.1",
      "title": "LSTM",
      "pages": [
        5,
        6
      ],
      "core_logic": "三门/候选/状态/输出标准说明，有c前态连接和符号异常需实现核对。",
      "level": 2,
      "parent_number": "3",
      "object_id": "p_f6b2f76f829fe8f8.sections.7",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "3.2",
      "title": "Bidirection LSTM",
      "pages": [
        6,
        7
      ],
      "core_logic": "两方向隐藏状态融合；仅历史输入窗反向不天然构成未来泄漏。",
      "level": 2,
      "parent_number": "3",
      "object_id": "p_f6b2f76f829fe8f8.sections.8",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "3.3",
      "title": "NODE",
      "pages": [
        7,
        8
      ],
      "core_logic": "ResNet→ODE→逐输入值的共享流映射→末态拼接/FC压缩。",
      "level": 2,
      "parent_number": "3",
      "object_id": "p_f6b2f76f829fe8f8.sections.9",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "4",
      "title": "Data and Methodology",
      "pages": [
        8,
        9,
        10,
        11,
        12
      ],
      "core_logic": "年内顺序split、滑窗、三组网络和验证集调参。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_f6b2f76f829fe8f8.sections.10",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "4.1",
      "title": "Data Source and Data Preprocessing",
      "pages": [
        8,
        9
      ],
      "core_logic": "2019–21每年5/2–7/4半小时负荷，minmax后60/20/20；scaler拟合范围不明。",
      "level": 2,
      "parent_number": "4",
      "object_id": "p_f6b2f76f829fe8f8.sections.11",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "4.2",
      "title": "Forecasting Modeling Method",
      "pages": [
        9
      ],
      "core_logic": "20历史点预测h1/3/5/7单目标，而非一次输出整条未来序列。",
      "level": 2,
      "parent_number": "4",
      "object_id": "p_f6b2f76f829fe8f8.sections.12",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "4.3",
      "title": "Forecasting Models",
      "pages": [
        9,
        10,
        11
      ],
      "core_logic": "CBL/BLL/BBLL各增加前置NODE，对照保留其他架构；参数预算未匹配。",
      "level": 2,
      "parent_number": "4",
      "object_id": "p_f6b2f76f829fe8f8.sections.13",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "4.4",
      "title": "Model Settings",
      "pages": [
        11,
        12
      ],
      "core_logic": "网格搜节点/窗/batch，验证早停，五次训练平均。",
      "level": 2,
      "parent_number": "4",
      "object_id": "p_f6b2f76f829fe8f8.sections.14",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "5",
      "title": "Experimental Results and Analysis",
      "pages": [
        12,
        13,
        14,
        15,
        16,
        17,
        18
      ],
      "core_logic": "指标→年份和h矩阵→局部曲线→机制解释。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_f6b2f76f829fe8f8.sections.15",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "5.1",
      "title": "Comparing Metric",
      "pages": [
        13,
        14,
        15
      ],
      "core_logic": "2019箱图、三年均值表；长h总体改善但存在具体劣化。",
      "level": 2,
      "parent_number": "5",
      "object_id": "p_f6b2f76f829fe8f8.sections.16",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "5.2",
      "title": "Forecasting Results Comparison",
      "pages": [
        15,
        17,
        18
      ],
      "core_logic": "2019 h3/5/7全测试曲线与三个放大窗解释峰值。",
      "level": 2,
      "parent_number": "5",
      "object_id": "p_f6b2f76f829fe8f8.sections.17",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "5.3",
      "title": "Experimental Results Analysis",
      "pages": [
        15,
        16
      ],
      "core_logic": "连续性/自适应步长解释收益，承认一步复杂度/过拟合可能；没有独立机制试验。",
      "level": 2,
      "parent_number": "5",
      "object_id": "p_f6b2f76f829fe8f8.sections.18",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
    {
      "number": "6",
      "title": "Conclusions",
      "pages": [
        18
      ],
      "core_logic": "概括潜力，明确单变量/长预测/其他ODE导数网络/GRU未做与插补未来方向。",
      "level": 1,
      "parent_number": null,
      "object_id": "p_f6b2f76f829fe8f8.sections.19",
      "source_sha256": "f6b2f76f829fe8f8281a0fa9b3956e0bd3af6d71f2dad628b3f1f97baf345240"
    },
